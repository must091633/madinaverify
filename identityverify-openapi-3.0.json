                    "meta": {
                      "request_id": "req_bvn_watch_1092"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v2/bvn/advance-match": {
      "post": {
        "summary": "BVN Advance Match (Name & DoB)",
        "description": "Calculates high-accuracy fuzzy matching scores across first name, surname, middle name, date of birth, and phone number against the verified BVN profile. Eliminates friction caused by variations in Nigerian naming order or alternate spellings.",
        "operationId": "bvn-advance-match",
        "tags": [
          "BVN"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bvn": {
                    "type": "string",
                    "description": "11-digit BVN",
                    "example": "22187394012"
                  },
                  "first_name": {
                    "type": "string",
                    "description": "First name provided by user",
                    "example": "Adebayo"
                  },
                  "last_name": {
                    "type": "string",
                    "description": "Last name / Surname provided by user",
                    "example": "Ibrahim"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "description": "Date of birth (YYYY-MM-DD)",
                    "example": "1992-04-14"
                  },
                  "phone_number": {
                    "type": "string",
                    "description": "Phone number in E.164 or local format",
                    "example": "+2348039201847"
                  },
                  "customer_consent": {
                    "type": "boolean",
                    "description": "NDPR user consent acknowledgment",
                    "example": true
                  }
                },
                "required": [
                  "bvn",
                  "first_name",
                  "last_name",
                  "customer_consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comprehensive fuzzy matching confidence metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "code": "BVN_MATCH_SUCCESS",
                    "data": {
                      "bvn": "22187394012",
                      "match_status": "ACCEPTED",
                      "overall_confidence": 96.5,
                      "field_scores": {
                        "first_name": {
                          "score": 100,
                          "status": "EXACT_MATCH",
                          "submitted": "Adebayo",
                          "registered": "Adebayo"
                        },
                        "last_name": {
                          "score": 100,
                          "status": "EXACT_MATCH",
                          "submitted": "Ibrahim",
                          "registered": "Ibrahim"
                        },
                        "date_of_birth": {
                          "score": 100,
                          "status": "EXACT_MATCH",
                          "submitted": "1992-04-14",
                          "registered": "1992-04-14"
                        },
                        "phone_number": {
                          "score": 95,
                          "status": "MATCH",
                          "submitted": "+2348039201847",
                          "registered": "08039201847"
                        }
                      },
                      "recommendation": "AUTOMATED_APPROVAL",
                      "verified_at": "2026-09-02T16:45:22Z"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v2/bvn/match-face": {
      "post": {
        "summary": "BVN Biometric Face Match",
        "description": "Submits a live selfie image (or base64 capture with optional liveness detection) and performs 1:1 facial geometry comparison against the official photo stored in the NIBSS BVN database. Returns biometric match confidence percentage and liveness score.",
        "operationId": "bvn-match-face",
        "tags": [
          "BVN"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bvn": {
                    "type": "string",
                    "description": "11-digit BVN",
                    "example": "22187394012"
                  },
                  "selfie_image": {
                    "type": "string",
                    "description": "Base64 encoded JPEG/PNG image or public HTTPS URL",
                    "example": "data:image/jpeg;base64,/9j/4AAQSkZJRg..."
                  },
                  "check_liveness": {
                    "type": "boolean",
                    "description": "Perform 3D passive anti-spoofing check",
                    "example": true
                  },
                  "customer_consent": {
                    "type": "boolean",
                    "description": "NDPR compliance flag",
                    "example": true
                  }
                },
                "required": [
                  "bvn",
                  "selfie_image",
                  "customer_consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Facial comparison passed above safety threshold",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "code": "FACE_MATCH_VERIFIED",
                    "data": {
                      "bvn": "22187394012",
                      "matched": true,
                      "face_confidence_score": 94.8,
                      "threshold_required": 80,
                      "liveness_result": {
                        "passed": true,
                        "liveness_score": 99.1,
                        "anti_spoofing": "GENUINE_HUMAN_FACE"
                      },
                      "verified_at": "2026-09-02T16:46:00Z"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v2/nin/verify-vnin": {
      "post": {
        "summary": "Virtual NIN (vNIN) Verification",
        "description": "The mandatory privacy-protecting tokenization protocol introduced by the National Identity Management Commission (NIMC) and endorsed by the Central Bank of Nigeria. Users generate a 16-character alphanumeric code using USSD code *346*3*NIN*EnterpriseID# or the NIMC MWS Mobile ID App. Returns verified demographic profile without exposing the raw 11-digit NIN.",
        "operationId": "nin-verify-vnin",
        "tags": [
          "NIN"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vnin": {
                    "type": "string",
                    "description": "16-character alphanumeric token",
                    "example": "AB4839201948NG01"
                  },
                  "agent_enterprise_id": {
                    "type": "string",
                    "description": "Your assigned NIMC Enterprise Agent Code (defaults to your organization code)",
                    "example": "IDV-NIMC-7489"
                  },
                  "customer_consent": {
                    "type": "boolean",
                    "description": "NDPR compliance confirmation",
                    "example": true
                  }
                },
                "required": [
                  "vnin",
                  "customer_consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Citizen demographic record from NIMC national database",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "code": "VNIN_VALIDATED",
                    "message": "Virtual NIN verified successfully.",
                    "data": {
                      "vnin": "AB4839201948NG01",
                      "first_name": "Adebayo",
                      "surname": "Ibrahim",
                      "middle_name": "Oluwaseun",
                      "date_of_birth": "1992-04-14",
                      "gender": "M",
                      "mobile_number": "+2348039201847",
                      "state_of_origin": "Oyo State",
                      "lga_of_origin": "Ibadan North",
                      "address": "Plot 14 Admiralty Way, Lekki Phase 1, Lagos",
                      "title": "Mr",
                      "tracking_id": "TRK-NIMC-9920184",
                      "photo": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEAYABgAAD...",
                      "verified_at": "2026-09-02T16:46:45Z"
                    },
                    "meta": {
                      "charge_applied": 50,
                      "currency": "NGN",
                      "request_id": "req_nin_vnin_77218"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "vNIN is older than 72 hours or already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "error",
                    "code": "VNIN_EXPIRED_OR_USED",
                    "message": "Supplied Virtual NIN token is invalid, expired, or has previously been consumed by an enterprise reader.",
                    "meta": {
                      "request_id": "req_nin_err_410"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
