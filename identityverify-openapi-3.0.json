                  "type": "object",
                  "example": {
                    "status": "warning",
                    "code": "BVN_WATCHLISTED_FLAG",
                    "message": "Subject BVN is listed on the NIBSS AML/Watchlist alert registry. Flagged by reporting institution.",
                    "data": {
