{
  "openapi": "3.0.3",
  "info": {
    "title": "IdentityVerify Nigeria - BVN, NIN & CAC Verification API",
    "version": "2.4.0",
    "description": "Official API specification for Nigerian banking and regulatory compliance: Bank Verification Number (BVN / NIBSS), National Identification Number (NIN / NIMC vNIN), and Corporate Affairs Commission (CAC / CAMA 2020) corporate registries.",
    "contact": {
      "name": "API Support & Compliance",
      "email": "api-support@identityverify.ng",
      "url": "https://identityverify.ng"
    }
  },
  "servers": [
    {
      "url": "https://sandbox.identityverify.ng",
      "description": "Sandbox Testing Environment (Zero charge)"
    },
    {
      "url": "https://api.identityverify.ng",
      "description": "Production Live Environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Secret Key (sec_live_... / sec_test_...)"
      }
    }
  },
  "paths": {
    "/v2/bvn/verify-basic": {
      "post": {
        "summary": "Basic BVN Validation",
        "description": "Validates whether the supplied 11-digit BVN exists in the NIBSS (Nigeria Inter-Bank Settlement System) repository. Returns the registration validity, enrollment status, and masked holder full name for fast and affordable level-1 KYC verification.",
        "operationId": "bvn-verify-basic",
        "tags": [
          "BVN"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bvn": {
                    "type": "string",
                    "description": "11-digit Nigerian Bank Verification Number",
                    "example": "22187394012"
                  },
                  "customer_consent": {
                    "type": "boolean",
                    "description": "Explicit confirmation that user consented to BVN validation under NDPR regulations",
                    "example": true
                  }
                },
                "required": [
                  "bvn",
                  "customer_consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "BVN successfully validated against central banking repository",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "code": "BVN_VALID",
                    "message": "Bank Verification Number validated successfully.",
                    "data": {
                      "bvn": "22187394012",
                      "is_valid": true,
                      "status": "active",
                      "masked_name": "ADEBAYO O*** I***",
                      "first_name": "Adebayo",
                      "last_name": "Ibrahim",
                      "middle_name": "Oluwaseun",
                      "enrollment_bank": "058 - GUARANTY TRUST BANK PLC",
                      "enrollment_branch": "Victoria Island 2, Lagos",
                      "watchlisted": false,
                      "verified_at": "2026-09-02T16:44:12Z"
                    },
                    "meta": {
                      "charge_applied": 25,
                      "currency": "NGN",
                      "request_id": "req_bvn_882910472"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "BVN does not exist in the NIBSS central switch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "error",
                    "code": "BVN_NOT_FOUND",
                    "message": "No record found for the supplied 11-digit BVN in the NIBSS registry.",
                    "meta": {
                      "request_id": "req_bvn_err_9012"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/v2/bvn/lookup-full": {
      "post": {
        "summary": "Full BVN Demographics & Photo",
        "description": "Performs comprehensive Tier-3 KYC verification on a customer BVN. Returns full name, verified date of birth, registered phone number, gender, state of origin, LGA of origin, residential address, registration date, and official photo.",
        "operationId": "bvn-lookup-full",
        "tags": [
          "BVN"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bvn": {
                    "type": "string",
                    "description": "11-digit Bank Verification Number",
                    "example": "22187394012"
                  },
                  "customer_consent": {
                    "type": "boolean",
                    "description": "Mandatory NDPR compliance flag",
                    "example": true
                  },
                  "include_photo": {
                    "type": "boolean",
                    "description": "Whether to return the base64 encoded photo record (defaults to true)",
                    "example": true
                  }
                },
                "required": [
                  "bvn",
                  "customer_consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete verified KYC demographic record returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "success",
                    "code": "BVN_FULL_RETRIEVED",
                    "message": "Full demographic data retrieved successfully.",
