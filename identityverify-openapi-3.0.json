              "schema": {
                "type": "object",
                "properties": {
                  "search_term": {
                    "type": "string",
                    "description": "Company name keyword or RC/BN registration code",
                    "example": "ZENITH LOGISTICS"
                  },
                  "classification": {
                    "type": "string",
                    "description": "Filter by entity type (ALL, RC, BN, IT, LLC)",
